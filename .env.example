@"
# Copy to .env for local use. Never commit a real .env file.
# Later milestones add their variables in the same PR as the code that reads them.

# AWS SSO profile used by the CLI and CDK on the operator machine.
AWS_PROFILE=proofdesk-dev

# Region for all data and model calls (Australia, Sydney).
AWS_REGION=ap-southeast-2

# Deployment stage: dev or prod.
PROOFDESK_STAGE=dev
"@ | Set-Content -Path .env.example -Encoding utf8NoBOM
