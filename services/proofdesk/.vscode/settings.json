// services/proofdesk/.vscode/settings.json: Python tools for the "python" folder.
{
  // The virtual environment that `uv sync` creates. On Windows: .venv\Scripts\python.exe
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.testing.pytestEnabled": true,
  // --no-cov: one test file never reaches the 90% coverage gate set in pyproject.toml.
  "python.testing.pytestArgs": ["tests", "--no-cov"],
  // Use the mypy installed in .venv, so the editor and CI run the same version.
  "mypy-type-checker.importStrategy": "fromEnvironment"
}
