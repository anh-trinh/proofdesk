{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./samples/private/**)",
      "Bash(cdk deploy *)",
      "Bash(cdk bootstrap *)",
      "Bash(aws s3 rm *)",
      "Bash(aws dynamodb delete-table *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(gh pr merge *)"
    ],
    "ask": [
      "Edit(./.github/workflows/**)",
      "Edit(./infra/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "make check-fast 1>&2 || exit 2" }
        ]
      }
    ]
  }
}
